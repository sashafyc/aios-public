# Секреты — НИКОГДА не коммитить
.env
bridge/.env
*.env

# Конфиг агентов — пользовательский (генерит install.sh). git pull его не трогает,
# поэтому кастомные агенты и правки не теряются при обновлении. В репо — только
# шаблон bridge/agents.toml.example.
bridge/agents.toml

# Runtime-состояние
.bridge.lock
bridge/.bridge.lock
bridge/.rate_limits.json
bridge/queue/
**/.state
# История диалога DeepSeek-агентов (персист между рестартами)
**/.deepseek_history.jsonl
**/.deepseek_history.jsonl.tmp

# Логи и рабочие файлы
logs/
workspace/temp/
workspace/permanent/*
!workspace/permanent/.gitkeep

# Архивы контекста агентов
agents/**/context_archive/

# Рантайм-память агентов (пишется в процессе работы) — НЕ в VCS, переживает
# обновления. В репо трекаются только шаблоны в _template/ (для новых агентов).
agents/*/context.md
agents/*/journal.md
!agents/_template/context.md
!agents/_template/journal.md

# Инструкции «мягких» (рабочих) агентов — user-owned, git pull их НЕ трогает.
# В репо только шаблоны *.example. Сисадмин («твёрдый») трекается как обычно.
agents/assistant/CLAUDE.md
agents/scriber/CLAUDE.md

# Бэкапы обновлений (scripts/update.sh)
.backups/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db
