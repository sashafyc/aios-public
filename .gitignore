# Секреты — НИКОГДА не коммитить
.env
bridge/.env
*.env

# Runtime-состояние
.bridge.lock
bridge/.bridge.lock
bridge/.rate_limits.json
bridge/queue/
**/.state
# История диалога DeepSeek-агентов (персист между рестартами)
**/.deepseek_history.jsonl
**/.deepseek_history.jsonl.tmp

# Логи и рабочие файлы
logs/
workspace/temp/
workspace/permanent/*
!workspace/permanent/.gitkeep

# Архивы контекста агентов
agents/**/context_archive/

# Бэкапы обновлений (scripts/update.sh)
.backups/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db
