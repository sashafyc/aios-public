# ════════════════════════════════════════════════════════════
#  aios-public — переменные окружения
#  install.sh создаёт из этого шаблона файл .env (chmod 600).
#  НИКОГДА не коммить .env в git — там секреты.
# ════════════════════════════════════════════════════════════

# ───────────── Обязательное ─────────────

# Токен Telegram-бота (от @BotFather). Один бот на все топики.
BOT_TOKEN=

# ID Telegram-группы с топиками (отрицательное число вида -100XXXXXXXXXX).
# Узнать: переслать сообщение из группы боту @raw_data_bot, поле "chat_id".
AIOS_GROUP_CHAT_ID=

# (Опционально) Белый список user_id, кому разрешено управлять агентами.
# Пусто = любой участник группы (модель «приватная группа = доверенные»).
# Заполни через запятую (ALLOWED_USER_IDS=123,456), если в группе есть люди,
# которым НЕ нужно давать доступ к агентам. Свой id — у @raw_data_bot.
ALLOWED_USER_IDS=

# Корень установки. install.sh прописывает реальный путь.
# Mac: ~/aios-public · VPS под root: /home/aios/aios-public · VPS под юзером: ~/aios-public
AIOS_ROOT=

# ───────────── Runner'ы (нужен хотя бы один) ─────────────
# claude / codex / gemini авторизуются через свой CLI (claude auth / codex auth / gemini auth) —
# токен в .env им не нужен. API-режимы используют ключи ниже.

# DeepSeek API (runner_type = "deepseek") — самый дешёвый вариант.
DEEPSEEK_API_KEY=

# OpenAI API (опционально, для codex в API-режиме).
OPENAI_API_KEY=

# ───────────── Опциональное ─────────────

# AssemblyAI — голосовые в любом топике + агент Скрайбер (транскрибация, YouTube).
# Бесплатно $50 на старте: assemblyai.com → Settings → API Keys.
ASSEMBLYAI_API_KEY=

# ───────────── Расписание / таймзона ─────────────

# Смещение от UTC в часах (МСК = 3, CET = 1, UTC = 0).
TIMEZONE_OFFSET_HOURS=3

# Время ежедневного сброса сессий агентов (по локальной таймзоне выше).
DAILY_RESET_HOUR=6
DAILY_RESET_MINUTE=30

# ───────────── Баг-репорты (опционально, по умолчанию ВЫКЛ) ─────────────

# Анонимная отправка баг-репортов разработчику. 0 = выкл (баги только локально,
# logs/bugs/). 1 = включить отправку (нужен URL ниже). Что уходит: версия, ОС,
# тип ошибки, обрезанный стектрейс с заменой путей. Что НЕ уходит: файлы,
# переписка, ключи, личные данные. Подробности — PRIVACY.md.
AIOS_BUGREPORT=0
# Endpoint разработчика. Пусто = отправка не работает даже при AIOS_BUGREPORT=1.
AIOS_BUGREPORT_URL=

# ───────────── Прочее (обычно не трогать) ─────────────

# Базовый URL Telegram API (для прокси; по умолчанию официальный).
# TG_API_BASE=https://api.telegram.org
