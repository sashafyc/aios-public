{
  "_comment": "Settings ТОЛЬКО для Сисадмина. Формат — нативные permissions Claude Code (deny/ask). Сисадмин управляет системой, поэтому ему НЕ запрещён доступ к bridge/.env (прописать API-ключи) — в отличие от settings.json остальных агентов. Деструктивные команды и системные секреты (/etc/shadow, ~/.ssh, credentials.json) запрещены всем. install.sh заменяет __AIOS_ROOT__.",
  "cacheRetention": "long",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm --recursive:*)",
      "Bash(dd:*)",
      "Bash(mkfs*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(shred:*)",
      "Bash(chmod -R 000:*)",
      "Bash(chown -R nobody:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(systemctl stop ssh*)",
      "Bash(systemctl disable ssh*)",
      "Bash(ufw disable:*)",
      "Bash(iptables -F:*)",
      "Bash(passwd:*)",
      "Bash(userdel:*)",
      "Bash(groupdel:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(wget:* | bash)",
      "Read(//etc/shadow)",
      "Read(//etc/passwd)",
      "Read(//etc/sudoers)",
      "Edit(//etc/shadow)",
      "Edit(//etc/passwd)",
      "Edit(//etc/sudoers)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.claude/credentials.json)",
      "Edit(~/.claude/credentials.json)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(systemctl stop:*)",
      "Bash(systemctl disable:*)"
    ]
  }
}
